{
  "name": "opencode-ultracode-workflow-plugin",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "lint:container": "dagger call lint --source .",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "validate:assets": "tsx scripts/validate-assets.ts",
    "validate:installers": "tsx scripts/validate-installers.ts",
    "check": "tsx scripts/validate-assets.ts && tsx scripts/validate-installers.ts && tsc --noEmit && eslint . && node --import tsx --test \"tests/**/*.test.ts\"",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opencode/plugin": "2.2.5",
    "@types/node": "^20.19.0",
    "eslint": "^10.14.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "pnpm@11.4.0"
}
