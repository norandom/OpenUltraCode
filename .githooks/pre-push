#!/usr/bin/env sh
# OpenUltraCode pre-push gate for releases: a v* tag is only pushed after the runtime check
# passed against a real opencode installation (scripts/runtime-check.mjs --live). Unit tests
# with fakes cannot see undeclared variants, missing providers, or 400 responses.
# Bypass only deliberately: git push --no-verify
set -eu

cd "$(git rev-parse --show-toplevel)"

pushes_release_tag=0
while read -r local_ref _local_sha _remote_ref _remote_sha; do
  case "$local_ref" in
    refs/tags/v*) pushes_release_tag=1 ;;
  esac
done

[ "$pushes_release_tag" -eq 1 ] || exit 0

if ! command -v opencode >/dev/null 2>&1; then
  printf 'pre-push: a release tag needs the runtime check, but opencode is not on PATH.\n' >&2
  exit 1
fi
printf 'pre-push: release tag detected; running the runtime check against the installed opencode...\n' >&2
opencode reload >/dev/null 2>&1 || true
node scripts/runtime-check.mjs --live || {
  printf 'pre-push: the runtime check failed; fix the installation before releasing.\n' >&2
  exit 1
}
